# Copy to .env and fill in. Never commit .env.
# A fresh clone must run the full demo with these defaults (mocks on, no keys).

# Backend
# Mocks are the default. Only an explicit false/0/no/off turns them off, so a
# typo here leaves the demo working rather than reaching for an API.
USE_MOCKS=true
CORS_ORIGINS=http://localhost:3000
# Optional integer: fixes the Monte Carlo seed so demo numbers repeat. Leave unset for random.
SIMULATION_SEED=
# User answers (categories, minimum balance, goals, reserve) are saved to
# backend/.data/answers.json so they survive a restart; delete it to start over.
# Uncomment to move the file, or set it empty to keep answers in memory only.
# TWIN_ANSWERS_PATH=

# Capital One Nessie. Only read when USE_MOCKS is off; without a key the
# fixtures stay in charge. Get a key at http://api.nessieisreal.com, then run
# `uv run python -m backend.nessie.seed` to put Alex in the sandbox.
NESSIE_API_KEY=
# Optional comma-separated account ids. Unset means every account the key owns.
NESSIE_ACCOUNT_IDS=
# Optional. Note the scheme: the documented http:// host refuses connections.
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_TIMEOUT_SECONDS=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Goal compiler for POST /goals/compile: rules (default) or llm.
# llm needs ANTHROPIC_API_KEY; without it, or if the call fails, it falls back to rules.
GOAL_COMPILER=rules
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Record every twin build as an MLflow run (Phase 6). Off unless set to true.
# MLFLOW_TRACKING_URI is read by MLflow itself; empty means a local mlflow.db in
# the directory the backend runs from. Point it at Databricks or a server to share runs.
TRACK_TWIN_BUILDS=false
MLFLOW_TRACKING_URI=
# Empty means "twin-builds". Databricks needs a workspace path, e.g. /Shared/twin-builds.
MLFLOW_EXPERIMENT_NAME=
# To log to Databricks: MLFLOW_TRACKING_URI=databricks plus your own workspace
# host and personal access token. Without them tracking logs a warning and skips.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
