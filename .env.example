# Copy to .env and fill in. Never commit .env.
# A fresh clone must run the full demo with these defaults (mocks on, no keys).

# Backend
USE_MOCKS=true
CORS_ORIGINS=http://localhost:3000
# Optional integer: fixes the Monte Carlo seed so demo numbers repeat. Leave unset for random.
SIMULATION_SEED=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Goal compiler for POST /goals/compile: rules (default) or llm.
# llm needs ANTHROPIC_API_KEY; without it, or if the call fails, it falls back to rules.
GOAL_COMPILER=rules
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Later phases (unused in Phase 1)
# NESSIE_API_KEY=
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
