{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(export -p)",
      "Bash(set)",
      "Bash(ant auth *)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(grep *.env*)"
    ]
  }
}
